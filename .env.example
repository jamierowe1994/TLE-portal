AUTH_SECRET=change-me
ANTHROPIC_API_KEY=       # powers the dashboard TLE Assistant chat — create at console.anthropic.com → API keys
ADMIN_EMAILS=susan@thelettingexperts.co.uk,james@therecruitmentexperts.co.uk
PRETENANCY_EMAILS=kirstie.mulholland@thelettingexperts.co.uk  # duo admin login — these accounts land on /pretenancy (Kirstie's move-in board)
DATABASE_URL=            # optional — Railway Postgres; JSON files in DATA_DIR if unset
DATA_DIR=                # optional — Railway Volume mount, e.g. /data
REX_API_BASE=https://api.uk.rexsoftware.com
REX_API_EMAIL=
REX_API_PASSWORD=
REX_ACCOUNT_ID=          # TLE shares the Property/Lettings REX account — copy REX_ACCOUNT_LETTINGS from the TEG Railway project
META_SYSTEM_TOKEN=       # same System User token as TEG (copy from TEG Railway)
META_APP_SECRET=         # required — every Graph call signed with appsecret_proof
META_AD_ACCOUNT_LETTINGS=  # TLE ad account id (act_…) — NOT yet set in TEG either (brand-meta had nulls); wire when known
META_PAGE_LETTINGS=      # TLE Facebook page id — needed for leadgen retrieval later

# --- Propoly: tenancy progression (deals → Applications/Pipeline) ---
# Auth per their Swagger: GET /api/v1/token with x-api-key + agent-name headers → JWT.
# (PROPOLY_USERNAME / PROPOLY_PASSWORD are accepted as aliases for the same two values.)
PROPOLY_API_BASE=https://api.propoly.com
PROPOLY_AGENT_NAME=      # the "username" Propoly issued — also unlocks their Swagger docs site
PROPOLY_API_KEY=         # the long key-like "password" that came with it

# --- Go High Level: paid leads + lead→MA funnel ---
# Private Integration token: GHL → the TLE sub-account → Settings →
# Private Integrations → create one with READ scopes for contacts,
# opportunities and locations. GHL_LOCATION_ID is the sub-account id
# (Settings → Business Profile, or the /location/<id>/ part of the GHL URL).
GHL_API_TOKEN=
GHL_LOCATION_ID=

# --- My Ads: connect to the sister Ads app (TEG PAID ADS) ---
ADS_API_BASE=            # the Ads app's URL, e.g. https://teg-paid-ads.up.railway.app
ADS_API_KEY=            # shared secret — the SAME value as PARTNER_API_KEY in the Ads app

# --- TEG Team Hub: group people database (live Agent Headcount) ---
# One endpoint, x-api-secret header. Secret grants FULL read/write to sensitive
# records — server-only, never expose client-side. Rotations: Howard Russell.
TEG_HUB_API_BASE=https://teg-team-hub.base44.app/functions/dbApi
TEG_HUB_API_SECRET=      # the rotated secret (the one printed in the PDF guide is dead)

# --- DocuSign: signed agreements into the property file ---
# JWT Grant (service integration) — nothing here runs with a user present, so
# Authorization Code is not an option. Set up in DocuSign as a PRIVATE CUSTOM
# integration: Apps and Keys → Service Integration → Generate RSA keypair.
#
# Keys are created in a DEVELOPER sandbox and copied into production by the
# Go-Live promotion. Settings do NOT travel with them, so demo and production
# end up as two complete sets of values — hence DOCUSIGN_ENV.
#
# First run will fail with consent_required: hit /api/admin/docusign-probe as an
# admin and open the consentUrl it returns. Consent is granted once, per account.
DOCUSIGN_ENV=demo        # demo | production — controls which DocuSign world we talk to
DOCUSIGN_INTEGRATION_KEY=  # the app's Integration Key (client id GUID), from Apps and Keys
DOCUSIGN_USER_ID=        # the API user's GUID to impersonate — NOT an email address
DOCUSIGN_PRIVATE_KEY=    # RSA private key PEM, shown ONCE at generation; escaped newlines are fine
DOCUSIGN_ACCOUNT_ID=     # optional — leave blank and the probe reports what's available.
                         # The account is shared across the six businesses like REX, so set
                         # this explicitly once known rather than trusting the default.
DOCUSIGN_REDIRECT_URI=  # must match a Redirect URI registered on the app EXACTLY (port included)
DOCUSIGN_CONNECT_HMAC_KEY=  # Connect shared secret — the ONLY thing guarding the public webhook
